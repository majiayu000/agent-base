{
  "name": "agent-base",
  "version": "1.0.0",
  "description": "Production-ready single agent template with LiteLLM support",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "bun run --watch src/example.ts",
    "start": "bun run src/example.ts",
    "chat": "bun run src/cli.ts",
    "analyze": "bun run src/analyze-project.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:vitest": "vitest run",
    "node:start": "tsx src/example.ts",
    "node:chat": "tsx src/cli.ts"
  },
  "dependencies": {
    "openai": "^4.70.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  }
}
